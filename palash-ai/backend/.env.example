PORT=3000
NODE_ENV=development
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=eduvaani_user
MYSQL_PASSWORD=replace_with_a_secure_password
MYSQL_DATABASE=eduvaani

# ── IndicTrans2 Python translation service ────────────────────────────────────
# URL of the FastAPI translation service (ml_pipeline/translation_service).
# Do NOT add a trailing slash.
# Default for local development (Python service on same machine as Node.js):
PYTHON_TRANSLATION_URL=http://127.0.0.1:8000
# Timeout in milliseconds for requests to the Python service (default: 30 s).
# Translation on CPU can take a few seconds; 30 s is a safe prototype value.
TRANSLATION_TIMEOUT_MS=30000
# Timeout for the lightweight Node /health -> Python /health probe.
TRANSLATION_HEALTH_TIMEOUT_MS=4000
